Engine: HySecTwinSecurityRisk
  description: Reference fuzzy configuration for reproducible HySecTwin uncertainty-aware reasoning

InputVariable: networkTrafficRate
  description: Normalized network-traffic anomaly intensity, 0=baseline and 1=strong deviation
  enabled: true
  range: 0.000 1.000
  lock-range: true
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

InputVariable: firmwareIntegrityRisk
  description: Normalized firmware-integrity risk, 0=verified and 1=unknown/unverified/compromised
  enabled: true
  range: 0.000 1.000
  lock-range: true
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

InputVariable: commandAnomaly
  description: Normalized command/control anomaly intensity
  enabled: true
  range: 0.000 1.000
  lock-range: true
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

OutputVariable: securityRisk
  description: Defuzzified HySecTwin security-risk score
  enabled: true
  range: 0.000 1.000
  lock-range: true
  aggregation: Maximum
  defuzzifier: Centroid 100
  default: 0.000
  lock-previous: false
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

RuleBlock: HySecTwinRules
  description: Compact reference rule base; deterministic rules remain in BenchMark/durable_rules_script.py
  enabled: true
  conjunction: Minimum
  disjunction: Maximum
  implication: Minimum
  activation: General
  rule: if networkTrafficRate is Low and firmwareIntegrityRisk is Low and commandAnomaly is Low then securityRisk is Low
  rule: if networkTrafficRate is Medium or firmwareIntegrityRisk is Medium or commandAnomaly is Medium then securityRisk is Medium
  rule: if networkTrafficRate is High then securityRisk is High
  rule: if firmwareIntegrityRisk is High then securityRisk is High
  rule: if commandAnomaly is High then securityRisk is High
  rule: if firmwareIntegrityRisk is Medium and commandAnomaly is Medium then securityRisk is High
