Engine: HySecTwinSmartLightingSecurityRisk
  description: Reference fuzzy configuration aligned with the HySecTwin smart-lighting CPS

InputVariable: stateMismatch
  description: Normalized mismatch between expected/physical context and reported light or DT state
  enabled: true
  range: 0.000 1.000
  lock-range: true
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

InputVariable: commandAnomaly
  description: Normalized deviation of switch/control commands from expected or authorised behaviour
  enabled: true
  range: 0.000 1.000
  lock-range: true
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

InputVariable: sensorContextAnomaly
  description: Normalized inconsistency between illumination/sensor context and reported or commanded device state
  enabled: true
  range: 0.000 1.000
  lock-range: true
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

OutputVariable: securityRisk
  description: Defuzzified HySecTwin security-risk score
  enabled: true
  range: 0.000 1.000
  lock-range: true
  aggregation: Maximum
  defuzzifier: Centroid 100
  default: 0.000
  lock-previous: false
  terms: Low Triangle 0.000 0.000 0.500
         Medium Triangle 0.250 0.500 0.750
         High Triangle 0.500 1.000 1.000

RuleBlock: HySecTwinSmartLightingRules
  description: Compact reference rules for light-state, command, sensor-context, and PT-DT inconsistencies
  enabled: true
  conjunction: Minimum
  disjunction: Maximum
  implication: Minimum
  activation: General
  rule: if stateMismatch is Low and commandAnomaly is Low and sensorContextAnomaly is Low then securityRisk is Low
  rule: if stateMismatch is Medium or commandAnomaly is Medium or sensorContextAnomaly is Medium then securityRisk is Medium
  rule: if stateMismatch is High then securityRisk is High
  rule: if commandAnomaly is High then securityRisk is High
  rule: if sensorContextAnomaly is High then securityRisk is High
  rule: if stateMismatch is Medium and sensorContextAnomaly is Medium then securityRisk is High
  rule: if commandAnomaly is Medium and stateMismatch is Medium then securityRisk is High
